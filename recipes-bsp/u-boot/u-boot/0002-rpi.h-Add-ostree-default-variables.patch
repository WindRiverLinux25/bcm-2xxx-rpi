From c22dd8e4d1fe6311d989471ce05274def52b3774 Mon Sep 17 00:00:00 2001
From: Rajeshkumar Ramasamy <rajeshkumar.ramasamy@windriver.com>
Date: Wed, 11 Oct 2023 04:18:35 +0000
Subject: [PATCH] [PATCH 2/2] rpi.env: Add ostree default variables

The ostree configuration requires several additional default variables
to be configured in the environment to properly boot the first time
before there is a saved environment file.

Upstream-Status: Inappropriate [ ostree specific ]

Signed-off-by: Rajeshkumar Ramasamy <rajeshkumar.ramasamy@windriver.com>
---
 board/raspberrypi/rpi/rpi.env | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/board/raspberrypi/rpi/rpi.env b/board/raspberrypi/rpi/rpi.env
index 30228285ed..7d447279f6 100644
--- a/board/raspberrypi/rpi/rpi.env
+++ b/board/raspberrypi/rpi/rpi.env
@@ -73,5 +73,11 @@ scriptaddr=0x02400000
 pxefile_addr_r=0x02500000
 fdt_addr_r=0x02600000
 ramdisk_addr_r=0x02700000
+use_fdtdtb=2
+initrd_addr=0x03000000
+console=ttyS0
+baudrate=115200
+loadaddr=0x00080000
+mmcdev=0
 
 boot_targets=mmc usb pxe dhcp
-- 
2.40.0

