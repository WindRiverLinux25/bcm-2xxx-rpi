From 1c8a2cdcdbb04d2d7980b43fb9b43083e3e89434 Mon Sep 17 00:00:00 2001
From: Kai Kang <kai.kang@windriver.com>
Date: Thu, 27 Mar 2025 06:36:14 +0000
Subject: [PATCH] xfce4-session: hide suspend operation

Suspend to RAM is not supported by raspberry.
So hide the button 'suspend' in 'Log Out' dialog to avoid trigger suspend operation.

Upstream-Status: Pending

Signed-off-by: Kai Kang <kai.kang@windriver.com>
---
 xfce4-session/xfsm-logout-dialog.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xfce4-session/xfsm-logout-dialog.c b/xfce4-session/xfsm-logout-dialog.c
index 7f63523..33fc8b5 100644
--- a/xfce4-session/xfsm-logout-dialog.c
+++ b/xfce4-session/xfsm-logout-dialog.c
@@ -300,7 +300,7 @@ xfsm_logout_dialog_init (XfsmLogoutDialog *dialog)
   if (xfconf_channel_get_bool (channel, "/shutdown/ShowSuspend", TRUE))
     {
       xfsm_shutdown_can_suspend (dialog->shutdown, &can_suspend, &auth_suspend);
-      if (can_suspend)
+      if (0)
         {
           button = xfsm_logout_dialog_button (_("Sus_pend"), "xfsm-suspend",
                                               "system-suspend", NULL,
-- 
2.48.1

